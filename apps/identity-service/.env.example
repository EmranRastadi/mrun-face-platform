# Copy to .env and fill real values. Never commit .env.
SERVICE_NAME=identity-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
PORT=3000
LOG_LEVEL=INFO

# Consul
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_ENABLED=true

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=identity-service
KAFKA_GROUP_ID=identity-workers
KAFKA_ENABLED=false

# Rate limiting / dedupe
IDENTITY_RATE_LIMIT_PER_MINUTE=30
IDENTITY_DEDUPE_TTL_SECONDS=300