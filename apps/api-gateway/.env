# Copy to .env and fill real values. Never commit .env.
SERVICE_NAME=api-gateway
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
PORT=3000
LOG_LEVEL=INFO

# Consul
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_ENABLED=false

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=api-gateway
KAFKA_GROUP_ID=api-gateway-workers
KAFKA_ENABLED=false

# Keycloak
KEYCLOAK_URL=http://keycloak.mrun-security.svc.cluster.local:8080

# Rate limiting / dedupe
API_GATEWAY_RATE_LIMIT_PER_MINUTE=30
API_GATEWAY_DEDUPE_TTL_SECONDS=300