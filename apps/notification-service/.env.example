# Copy to .env and fill real values. Never commit .env.
SERVICE_NAME=notification-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
PORT=3004
LOG_LEVEL=INFO

CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_ENABLED=false

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-workers
KAFKA_ENABLED=false

# Dragonfly (Redis-compatible)
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379
DRAGONFLY_ENABLED=false

# Rate limiting / dedupe
NOTIFY_RATE_LIMIT_PER_MINUTE=30
NOTIFY_DEDUPE_TTL_SECONDS=300

# Channel providers (stub until wired)
SMS_PROVIDER_URL=
PUSH_PROVIDER_URL=
EMAIL_PROVIDER_URL=
