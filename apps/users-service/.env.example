# Copy to .env and fill real values. Never commit .env.
SERVICE_NAME=users-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
PORT=3001
LOG_LEVEL=INFO
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=users
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_ENABLED=true
KAFKA_BROKERS=localhost:9092
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Keycloak token exchange. When running users-service on the host and
# port-forwarding Keycloak, the issuer is http://localhost:8080/realms/mrun.
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mrun
KEYCLOAK_CLIENT_ID=mrun-backend
# Keycloak derives `iss` from the request URL. Use the exact local issuer(s)
# for your port-forward, e.g. 8070 when 8080 is already taken.
KEYCLOAK_ISSUERS=http://localhost:8070/realms/mrun,http://127.0.0.1:8070/realms/mrun,http://localhost:8080/realms/mrun,http://127.0.0.1:8080/realms/mrun
KEYCLOAK_ALLOWED_CLIENTS=mrun-backend
KEYCLOAK_AUTO_PROVISION=true
KEYCLOAK_SYNC_ROLE=false
KEYCLOAK_JWKS_CACHE_SECONDS=600
