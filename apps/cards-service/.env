# Copy to .env and fill real values. Never commit .env.
SERVICE_NAME=cards-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
PORT=3001
LOG_LEVEL=INFO

# Consul
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_ENABLED=false

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=cards-service
KAFKA_GROUP_ID=cards-workers
KAFKA_ENABLED=false

# Keycloak
KEYCLOAK_URL=http://keycloak.mrun-security.svc.cluster.local:8080

# Rate limiting / dedupe
CARDS_RATE_LIMIT_PER_MINUTE=30
CARDS_DEDUPE_TTL_SECONDS=300