# Copy to .env and fill real values. Never commit .env.
SERVICE_NAME=enrollment-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
PORT=8001
LOG_LEVEL=INFO

CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_ENABLED=false

# Postgres (enrollment-db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=enrollment

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=enroll
MINIO_SECURE=false

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=face_embeddings
MILVUS_DIMENSION=512

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_ENABLED=false
