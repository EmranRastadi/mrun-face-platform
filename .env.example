# ---- MRUN local defaults (copy to .env, never commit real secrets) ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres (local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mrun

# Consul
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_ENABLED=true

# Kafka (local)
KAFKA_BROKERS=localhost:9092

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Services ports
API_GATEWAY_PORT=3000
USERS_SERVICE_PORT=3001
IDENTITY_SERVICE_PORT=3002
CARDS_SERVICE_PORT=8000
ENROLLMENT_SERVICE_PORT=8001
AUDIT_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
ANALYTICS_SERVICE_PORT=3005

# Dragonfly (hot state)
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379

# MinIO (blob storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=enroll

# Milvus (face embeddings)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=face_embeddings
MILVUS_DIM=512

# ClickHouse (analytics)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=mrun

# ---- WebRTC / ICE (development defaults only — replace credentials) ----
# URLs are what the *browser* must reach. Use the host LAN/public address when
# the browser is not running on the same machine as coturn.
WEBRTC_ENABLED=true
STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_USERNAME=mrun
TURN_PASSWORD=change-me-in-development
TURN_REALM=mrun.local
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_EXTERNAL_IP=127.0.0.1
WEBRTC_FORCE_RELAY=false
# Optional shared token for /webrtc/signaling. Empty = no token (dev only).
WEBRTC_SIGNALING_TOKEN=
